{
  "manifest_version": 3,
  "name": "CUIMS Clear",
  "version": "0.8.7",
  "description": "Faster CUIMS login, attendance and safe-skip counts without opening the portal, and a cleaner LMS.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://students.cuchd.in/*",
    "https://lms.cuchd.in/*"
  ],
  "background": {
    "scripts": [
      "lms-open.js",
      "themes.js",
      "theme-bg.js",
      "captcha-glyphs.js",
      "captcha-solver.js",
      "attendance-parse.js",
      "attendance-model.js",
      "attendance-client.js",
      "attendance-daemon.js",
      "attendance-bg.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; upgrade-insecure-requests"
  },
  "action": {
    "default_title": "CUIMS Clear",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://students.cuchd.in/*"
      ],
      "js": [
        "captcha-glyphs.js",
        "captcha-solver.js",
        "themes.js",
        "cuims-theme.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://students.cuchd.in/*"
      ],
      "js": [
        "lms-open-wrap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://students.cuchd.in/*"
      ],
      "js": [
        "themes.js",
        "lms-launch.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://lms.cuchd.in/*"
      ],
      "js": [
        "themes.js",
        "lms-boot.js",
        "lms-model.js",
        "lms.js"
      ],
      "css": [
        "lms.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cuims-clear@arshgill01",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
