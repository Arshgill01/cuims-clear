{
  "manifest_version": 3,
  "name": "CUIMS Clear",
  "version": "0.5.0",
  "description": "Speeds up CUIMS login, solves the CAPTCHA on-device, and suppresses event and feedback overlays.",
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://students.cuchd.in/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self' 'wasm-unsafe-eval'"
  },
  "web_accessible_resources": [
    {
      "resources": ["vendor/tesseract/*", "vendor/tessdata/*"],
      "matches": ["https://students.cuchd.in/*"]
    }
  ],
  "action": {
    "default_title": "CUIMS Clear",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://students.cuchd.in/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "120"
}
