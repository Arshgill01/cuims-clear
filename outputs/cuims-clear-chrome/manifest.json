{
  "manifest_version": 3,
  "name": "CUIMS Clear",
  "version": "0.9.1",
  "description": "Faster CUIMS login, attendance and safe-skip counts without opening the portal, and a cleaner LMS.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://students.cuchd.in/*",
    "https://lms.cuchd.in/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "CUIMS Clear",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://students.cuchd.in/*"
      ],
      "js": [
        "captcha-glyphs.js",
        "captcha-solver.js",
        "themes.js",
        "cuims-theme.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://students.cuchd.in/*"
      ],
      "js": [
        "lms-open-wrap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://students.cuchd.in/*"
      ],
      "js": [
        "themes.js",
        "lms-launch.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://lms.cuchd.in/*"
      ],
      "js": [
        "themes.js",
        "lms-boot.js",
        "lms-model.js",
        "lms.js"
      ],
      "css": [
        "lms.css"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "120"
}
